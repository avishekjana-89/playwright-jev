# ── Typesafe AI (Jev) ──────────────────────────────────────────────────────────
# Option A: Direct Typesafe AI
TYPESAFE_API_KEY=sk-...

# Option B: OpenRouter — routes Jev via OpenRouter (use EITHER A or B, not both)
# OPENROUTER_API_KEY=sk-or-v1-...
# TYPESAFE_BASE_URL is auto-set to https://openrouter.ai/api when OPENROUTER_API_KEY is present

# ── Playwright MCP ─────────────────────────────────────────────────────────────
# "stdio" = spawn local npx process (default, zero infra)
# "sse"   = connect to a running remote MCP server
PLAYWRIGHT_MCP_MODE=stdio
PLAYWRIGHT_MCP_SSE_URL=http://localhost:8931   # only used when mode=sse
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium                    # chromium | firefox | webkit

# ── Jev decision thresholds ────────────────────────────────────────────────────
JEV_VISUAL_THRESHOLD=0.60   # Noul probability; above = request screenshot

# ── Agent loop ─────────────────────────────────────────────────────────────────
MAX_STEPS_PER_TASK=50
STEP_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR
